---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseArticle from '../../components/CaseArticle.astro';
import MoveInWalkthrough from '../../components/presentations/MoveInWalkthrough';
import { getCase, publicCases } from '../../data/cases';
import { getRichCase, getRichCaseRewrite } from '../../data/case-studies';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return publicCases.map((item) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;
const item = getCase(slug!);

if (!item) {
  throw new Error(`Unknown case study: ${slug}`);
}

const rich = getRichCase(slug!);
const rewrite = getRichCaseRewrite(slug!);
---

<BaseLayout title={item.title} description={item.summary}>
  {
    rich ? (
      <>
      {rewrite ? (
        <>
          <CaseArticle item={item} rich={rewrite.case} version="a">
            <MoveInWalkthrough
              slot="lead"
              client:visible
              protoSrc={withBase('/prototypes/oxp-mobile/')}
              presentHref={withBase('/present/move-in-scanner/')}
              notes={rewrite.sceneNotes}
            />
          </CaseArticle>
          <CaseArticle item={item} rich={rich} version="b" hidden />
          <p class="case-version-mark" hidden>Original</p>

          <script>
            const DOUBLE_TAP_MS = 420;
            const reads = {
              a: document.querySelector<HTMLElement>('[data-case-version="a"]'),
              b: document.querySelector<HTMLElement>('[data-case-version="b"]'),
            };
            const mark = document.querySelector<HTMLElement>('.case-version-mark');
            let lastKey = '';
            let lastAt = 0;

            const typingInField = (target: EventTarget | null) => {
              if (!(target instanceof HTMLElement)) return false;
              const tag = target.tagName;
              return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || target.isContentEditable;
            };

            window.addEventListener('keydown', (event) => {
              if (event.metaKey || event.ctrlKey || event.altKey || event.repeat) return;
              if (typingInField(event.target)) return;

              const key = event.key.toLowerCase();
              if (key !== 'a' && key !== 'b') {
                lastKey = '';
                return;
              }

              const now = performance.now();
              const doubled = key === lastKey && now - lastAt < DOUBLE_TAP_MS;
              lastKey = key;
              lastAt = now;
              if (!doubled) return;

              event.preventDefault();
              lastKey = '';
              const show = reads[key];
              const hide = reads[key === 'a' ? 'b' : 'a'];
              if (!show || !hide || !show.hidden) return;
              hide.hidden = true;
              show.hidden = false;
              if (mark) mark.hidden = key === 'a';
              window.scrollTo({ top: 0, behavior: 'instant' });
            });
          </script>
        </>
      ) : (
        <CaseArticle item={item} rich={rich} />
      )}

      <dialog class="case-lightbox">
        <button type="button" class="case-lightbox__close" data-lightbox-close aria-label="Close">
          ×
        </button>
        <img alt="" />
      </dialog>

      <script>
        const dialog = document.querySelector('.case-lightbox');
        if (dialog instanceof HTMLDialogElement) {
          const image = dialog.querySelector('img');
          const close = dialog.querySelector('[data-lightbox-close]');

          document.querySelectorAll('.case-zoom').forEach((button) => {
            if (!(button instanceof HTMLButtonElement)) return;
            button.addEventListener('click', () => {
              if (!(image instanceof HTMLImageElement)) return;
              image.src = button.dataset.zoomSrc ?? '';
              image.alt = button.dataset.zoomAlt ?? '';
              dialog.showModal();
            });
          });

          close?.addEventListener('click', () => dialog.close());
          dialog.addEventListener('click', (event) => {
            if (event.target === dialog) dialog.close();
          });
          dialog.addEventListener('close', () => {
            if (image instanceof HTMLImageElement) image.removeAttribute('src');
          });
        }
      </script>
      </>
    ) : (
      <article class="shell page-hero">
        <p class="section__eyebrow">{item.eyebrow}</p>
        <h1>{item.title}</h1>
        <p>{item.summary}</p>

        <div class="meta-bar">
          <div>
            <strong>Role</strong>
            {item.role}
          </div>
          <div>
            <strong>Timeframe</strong>
            {item.timeframe}
          </div>
        </div>

        <div class="prose">
          <h2>Problem</h2>
          <p>{item.problem}</p>

          <h2>Process</h2>
          <ul>
            {item.process.map((step) => (
              <li>{step}</li>
            ))}
          </ul>

          <h2>Key decisions</h2>
          <ul>
            {item.decisions.map((step) => (
              <li>{step}</li>
            ))}
          </ul>

          <h2>Metrics & evidence</h2>
          <ul>
            {item.metrics.map((step) => (
              <li>{step}</li>
            ))}
          </ul>

          <h2>Outcome</h2>
          <p>{item.outcome}</p>

          <h2>Handoff</h2>
          <p>{item.handoff}</p>

          {item.builtWith && (
            <p class="built-with">
              <strong>Built with</strong> — {item.builtWith}
            </p>
          )}

          <h2>Tags</h2>
          <ul class="tag-row">
            {item.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>

          <p class="note" style="margin-top: 2rem;">
            Screenshots and deeper process detail land next. Full drafts live in the Portfolio prep
            workspace until sanitization is signed off.
          </p>

          <p style="margin-top: 2rem;">
            <a href={withBase('/work')}>← All work</a>
          </p>
        </div>
      </article>
    )
  }
</BaseLayout>
