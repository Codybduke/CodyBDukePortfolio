---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import { highlights, moreCases } from '../../data/cases';
---

<BaseLayout
  title="Work"
  description="Selected product design case studies — process, strategy, data, and outcomes."
>
  <div class="shell page-hero">
    <p class="section__eyebrow">Work</p>
    <h1>Case studies</h1>
    <p>
      Each writeup emphasizes decisions, metrics, and handoff — framed for Product Design roles
      that want ownership from research through delivery.
    </p>
  </div>

  <section class="section section--work shell" aria-label="Case studies">
    <div class="case-grid case-grid--compact">
      {highlights.map((item) => <CaseCard item={item} />)}
      {moreCases.map((item) => <CaseCard item={item} />)}
    </div>
  </section>
</BaseLayout>
