---
import type { CaseStudy } from '../data/cases';
import { withBase } from '../lib/paths';

interface Props {
  item: CaseStudy;
  lead?: boolean;
}

const { item, lead = false } = Astro.props;
const cover = item.cover;
const tags = item.tags.slice(0, 3);
const mediaStyle = [
  item.field ? `--cover-field: var(--field-${item.field})` : '',
  cover?.position ? `--cover-pos: ${cover.position}` : '',
  cover?.scale ? `--cover-scale: ${cover.scale}` : '',
  cover?.fit ? `--cover-fit: ${cover.fit}` : '',
]
  .filter(Boolean)
  .join('; ');
---

<a class:list={['case-card', lead && 'case-card--lead']} href={withBase(`/work/${item.slug}`)}>
  <div
    class:list={[
      'case-card__media',
      !cover && 'case-card__media--empty',
      item.field && 'case-card__media--mineral',
      cover?.video && 'case-card__media--video',
    ]}
    style={mediaStyle || undefined}
  >
    <div class="case-card__stage">
      {
        cover && (
          <img src={withBase(cover.src)} alt={cover.alt} loading="lazy" />
        )
      }
      {
        cover?.video && (
          <video
            data-dir="forward"
            src={withBase(cover.video)}
            poster={withBase(cover.src)}
            muted
            playsinline
            preload="auto"
            aria-hidden="true"
          />
        )
      }
      {
        cover?.videoReverse && (
          <video
            data-dir="reverse"
            src={withBase(cover.videoReverse)}
            muted
            playsinline
            preload="auto"
            aria-hidden="true"
          />
        )
      }
    </div>
  </div>
  <h3 class="case-card__title">
    <span>{item.title}</span>
  </h3>
  <ul class="case-card__tags" aria-label="Tags">
    {tags.map((tag) => (
      <li>{tag}</li>
    ))}
  </ul>
</a>
