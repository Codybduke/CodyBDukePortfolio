---
import PrintDocument from '../layouts/PrintDocument.astro';
import ResumeKit from '../components/resume/ResumeKit';
import { site } from '../data/site';
import { withBase } from '../lib/paths';
---

<PrintDocument
  title="Cody Duke, The One Res"
  description="Cody Duke, Senior Product Designer. Research, interaction design, and measured shipping."
>
  <ResumeKit
    client:load
    email={site.email}
    linkedin={site.linkedin}
    portfolioHref={withBase('/')}
  />
</PrintDocument>
