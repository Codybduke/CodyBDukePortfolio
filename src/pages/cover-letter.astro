---
import PrintDocument from '../layouts/PrintDocument.astro';
import ResumeKit from '../components/resume/ResumeKit';
import { site } from '../data/site';
import { withBase } from '../lib/paths';
---

<PrintDocument
  title="Cody Duke, Product Designer Cover Letter"
  description="Cody Duke cover letter for Product Designer at Tiny Health."
>
  <ResumeKit
    client:load
    email={site.email}
    linkedin={site.linkedin}
    portfolioHref={withBase('/')}
    initialCompanyId="tiny-health"
    initialDoc="letter"
  />
</PrintDocument>
