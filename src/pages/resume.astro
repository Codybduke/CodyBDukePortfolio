---
import PrintDocument from '../layouts/PrintDocument.astro';
import ResumeKit from '../components/resume/ResumeKit';
import { site } from '../data/site';
import { withBase } from '../lib/paths';
---

<PrintDocument
  title="Cody Duke, Product Designer Resume"
  description="Cody Duke, Product Designer resume. Retention loops, evidence, and AI-assisted delivery."
>
  <ResumeKit
    client:load
    email={site.email}
    linkedin={site.linkedin}
    portfolioHref={withBase('/')}
  />
</PrintDocument>
