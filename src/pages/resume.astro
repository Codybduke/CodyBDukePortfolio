---
import { site } from '../data/site';
import { withBase } from '../lib/paths';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Cody Duke — Product Designer resume. Retention loops, evidence, and AI-assisted delivery."
    />
    <title>Cody Duke — Product Designer Resume</title>
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=clash-grotesk@500,600&display=swap" rel="stylesheet" />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <p class="resume-chrome">
      <a href={withBase('/')}>← Portfolio</a>
      <button type="button" onclick="window.print()">Print / Save PDF</button>
    </p>

    <article class="resume">
      <header class="resume__header">
        <div>
          <h1>Cody Duke</h1>
          <p class="resume__role">Product Designer</p>
          <p class="resume__location">Utah-based, open to remote</p>
        </div>
        <address>
          <a href="tel:+15013395093">(501) 339-5093</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={withBase('/')}>Portfolio</a>
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </address>
      </header>

      <div class="resume__body">
        <aside class="resume__rail">
          <section>
            <h2>Profile</h2>
            <p class="resume__lede">
              <em>How I think about product design:</em>
            </p>
            <p>
              I design products people come back to. I work from field research, production data,
              and call research. Visual craft is part of the product. I frame the problem and
              partner with engineering, as the only designer or through a team.
            </p>
          </section>

          <section>
            <h2>Skills</h2>
            <ul class="resume__skills">
              <li>Retention and habit loops</li>
              <li>Field and call research</li>
              <li>Production data</li>
              <li>Systems UX</li>
              <li>Visual craft</li>
              <li>AI-assisted prototyping</li>
              <li>Figma</li>
              <li>Cursor</li>
              <li>SQL</li>
              <li>Expo</li>
              <li>SwiftUI</li>
              <li>FigJam</li>
            </ul>
          </section>

          <section>
            <h2>Education</h2>
            <p class="resume__school">
              <strong>BFA, Graphic Design</strong><br />
              Brigham Young University–Idaho<br />
              <span class="resume__school-date">2017</span>
            </p>
          </section>
        </aside>

        <div class="resume__main">
          <section>
            <h2>Work Experience</h2>

            <article class="job">
              <header class="job__head">
                <h3>Entrata</h3>
                <p class="job__dates">July 2019 – 2026</p>
              </header>
              <p class="job__title">Senior Product Designer · Product Lead (~1 year)</p>
              <ul>
                <li>
                  Dedicated designer for Greystar, one of the largest U.S. multifamily operators.
                </li>
                <li>Product Lead with an owned engineering team.</li>
                <li>
                  Led a team that designed and built an AI flow to read income documents and
                  autofill affordable-housing certification, so a long, high-pressure application
                  became an upload. Hundreds of teams entered. We won Most Likely to Land a New
                  Logo.
                </li>
                <li>
                  Simplified core workflows for Homebody, a resident-facing self-serve mobile app.
                  After launch, 4.4/5 on iOS from 600+ reviews in the first 6 months.
                </li>
                <li>
                  Redesigned a complex enterprise setup system to add flexibility without adding
                  complexity.
                </li>
                <li>
                  Designed a mobile workflow that turned a two-part data-entry process into a
                  real-time check-in, cutting the work of moving someone in by more than half.
                  Handed to the iOS team as SwiftUI.
                </li>
                <li>
                  Designed a field mobile experience that put daily on-site information on the
                  phone, so staff could answer in the moment instead of taking a note and finishing
                  it at a desk.
                </li>
              </ul>
            </article>

            <article class="job">
              <header class="job__head">
                <h3>FamilySearch</h3>
                <p class="job__dates">2017 – 2019</p>
              </header>
              <p class="job__title">UX Designer</p>
              <ul>
                <li>
                  Led product design of 26 personalized discovery experiences that served as an
                  entry point and a reason to come back.
                </li>
                <li>
                  Those campaigns retained 95% more members and 107% more other users than the
                  previous year, reached 1.1 million people outside the US, and earned 90% positive
                  feedback from 86,000 comments.
                </li>
                <li>
                  Oversaw third-party design so each campaign used the same tried-and-true loop.
                </li>
                <li>
                  Refined how the product team worked so we moved faster, did more thorough work,
                  and ran into fewer surprises.
                </li>
              </ul>
            </article>
          </section>
        </div>
      </div>
    </article>
  </body>
</html>

<style>
  :root {
    --resume-ink: #1c1c1a;
    --resume-muted: #5c5c56;
    --resume-line: rgba(28, 28, 26, 0.18);
    --resume-paper: #ffffff;
    --resume-field: #fbfbf1;
    --font-display: 'Clash Grotesk', 'Figtree', 'Helvetica Neue', sans-serif;
    --font-ui: 'Figtree', 'Helvetica Neue', sans-serif;
    --font-body: 'Source Serif 4', Georgia, 'Times New Roman', serif;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--resume-field);
    color: var(--resume-ink);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }

  .resume-chrome {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 8.5in;
    margin: 1.25rem auto 0.75rem;
    padding: 0 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .resume-chrome button {
    font: inherit;
    font-weight: 600;
    color: var(--resume-ink);
    background: transparent;
    border: 1px solid var(--resume-line);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    cursor: pointer;
  }

  .resume {
    width: 8.5in;
    min-height: 11in;
    margin: 0 auto 2.5rem;
    padding: 0.48in 0.58in 0.42in;
    background: var(--resume-paper);
    color: var(--resume-ink);
    box-shadow: 0 18px 40px rgba(28, 28, 26, 0.08);
  }

  .resume__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    padding-bottom: 0.24in;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2.15rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .resume__role {
    margin: 0.28rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--resume-muted);
  }

  .resume__location {
    margin: 0.22rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 400;
    line-height: 1.55;
    color: var(--resume-muted);
  }

  address {
    margin: 0;
    font-style: normal;
    font-family: var(--font-ui);
    font-size: 0.68rem;
    line-height: 1.55;
    text-align: right;
    color: var(--resume-muted);
  }

  address a {
    display: block;
    text-decoration: underline;
    text-underline-offset: 0.16em;
    text-decoration-color: rgba(28, 28, 26, 0.35);
  }

  .resume__body {
    display: grid;
    grid-template-columns: 2.35in 1fr;
    align-items: start;
  }

  .resume__rail {
    padding: 0 0.38in 0 0;
  }

  .resume__main {
    padding: 0 0 0 0.42in;
    border-left: 1px solid var(--resume-line);
  }

  h2 {
    margin: 0 0 0.58rem;
    padding-top: 0.12rem;
    border-top: 1px solid var(--resume-line);
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .resume__rail section + section,
  .resume__main .job + .job {
    margin-top: 0.32in;
  }

  .resume__rail p,
  .job p {
    margin: 0 0 0.42rem;
    font-size: 0.84rem;
    line-height: 1.42;
  }

  .resume__rail p:last-child,
  .job p:last-child {
    margin-bottom: 0;
  }

  .resume__lede {
    margin-bottom: 0.35rem !important;
  }

  .resume__lede em {
    font-family: var(--font-body);
    font-size: 0.84rem;
    font-weight: 600;
  }

  strong {
    font-weight: 600;
  }

  .resume__skills {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .resume__skills li {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.35;
    margin: 0 0 0.28rem;
  }

  .resume__skills li:last-child {
    margin-bottom: 0;
  }

  .job ul {
    margin: 0.16rem 0 0;
    padding: 0 0 0 0.95rem;
  }

  .job li {
    font-family: var(--font-body);
    font-size: 0.84rem;
    line-height: 1.42;
    margin: 0 0 0.36rem;
  }

  .job li:last-child {
    margin-bottom: 0;
  }

  .resume__school {
    font-size: 0.74rem !important;
    line-height: 1.4 !important;
  }

  .resume__school-date {
    color: var(--resume-muted);
  }

  .job__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
  }

  .job h3 {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
  }

  .job__dates {
    margin: 0 !important;
    font-family: var(--font-ui);
    font-size: 0.68rem !important;
    font-weight: 500;
    color: var(--resume-muted);
    white-space: nowrap;
  }

  .job__title {
    margin: 0.12rem 0 0.42rem !important;
    font-family: var(--font-ui);
    font-size: 0.72rem !important;
    color: var(--resume-muted);
  }

  @media print {
    @page {
      size: letter;
      margin: 0;
    }

    html,
    body {
      background: white;
    }

    .resume-chrome {
      display: none;
    }

    .resume {
      margin: 0;
      box-shadow: none;
      min-height: 11in;
    }
  }

  @media screen and (max-width: 900px) {
    body {
      background: var(--resume-paper);
    }

    .resume {
      width: auto;
      min-height: 0;
      margin: 0;
      padding: 1.5rem 1.25rem 2.5rem;
      box-shadow: none;
    }

    .resume__header,
    .resume__body,
    .job__head {
      display: block;
    }

    .resume__header address {
      text-align: left;
      margin-top: 1rem;
    }

    .resume__rail,
    .resume__main {
      padding: 1.25rem 0 0;
      border: 0;
    }

    .resume__main {
      border-top: 1px solid var(--resume-line);
    }
  }
</style>
