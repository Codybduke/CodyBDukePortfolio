---
import type { CaseEmbed } from '../data/case-studies/types';

type Props = {
  embed: CaseEmbed;
};

const { embed } = Astro.props;
const join = embed.src.includes('?') ? '&' : '?';
/** Same demo matrix as the case-study screenshots; lab chrome stays visible. */
const lab =
  'lab=1&version=full&eli=enabled&briefing=v2&device=ios&size=mobile&phoneSim=on&network=online&brand=preview';
const src = `${embed.src}${join}${lab}`;
---

<figure class="case-embed case-embed--lab">
  <div class="case-embed__frame">
    <iframe src={src} title={embed.title} loading="lazy" allow="fullscreen"></iframe>
  </div>
  <figcaption>
    <p>{embed.caption}</p>
    {embed.hint && <p class="case-embed__hint">{embed.hint}</p>}
    <p>
      <a href={src} target="_blank" rel="noopener noreferrer">Open in a new tab</a>
    </p>
  </figcaption>
</figure>
