---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import { highlights, moreCases } from '../../data/cases';
import { site } from '../../data/site';
---

<BaseLayout
  title="Work"
  description="Selected product design case studies — process, strategy, data, and outcomes."
>
  <div class="shell page-hero">
    <p class="section__eyebrow">Work</p>
    <h1>Case studies</h1>
    <p>
      Highlighted work first, then supporting cases and earlier craft. Each writeup emphasizes
      decisions, metrics, and handoff — framed for Product Design roles that want ownership from
      research through delivery.
    </p>
  </div>

  <section class="section shell" aria-labelledby="highlights-heading">
    <div class="section__head">
      <h2 class="section__title" id="highlights-heading">Highlights</h2>
    </div>
    <div class="case-grid">
      {highlights.map((item) => <CaseCard item={item} />)}
    </div>
  </section>

  <section class="section shell" aria-labelledby="more-work-heading">
    <div class="section__head">
      <h2 class="section__title" id="more-work-heading">More work</h2>
      <a class="section__link" href={site.behance} target="_blank" rel="noopener noreferrer"
        >Earlier visual work on Behance →</a
      >
    </div>
    <div class="case-grid case-grid--compact">
      {moreCases.map((item) => <CaseCard item={item} />)}
    </div>
  </section>
</BaseLayout>
